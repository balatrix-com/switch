DATABASE_URL=postgresql://switchuser:CHANGE_ME@127.0.0.1:5432/billing_switch?schema=public
BILLING_CACHE_PATH=./cache/billing_cache.json
BILLING_CACHE_REFRESH_TOKEN=change-me
