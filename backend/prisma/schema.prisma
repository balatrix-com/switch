generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Transport {
  UDP
  TCP
  TLS
}

enum AuthType {
  IP
  DIGEST
  IP_AND_DIGEST
}

enum SourceType {
  CARRIER
  CUSTOMER
}

enum EndpointDirection {
  INBOUND
  OUTBOUND
  BOTH
}

enum NumberInventoryStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  SUSPENDED
}

enum CustomerNumberStatus {
  ACTIVE
  SUSPENDED
}

enum RouteDirection {
  INBOUND
  OUTBOUND
}

enum MatchType {
  EXACT
  PREFIX
}

enum DestinationType {
  CUSTOMER_ENDPOINT
  EXTERNAL_NUMBER
  CARRIER_ENDPOINT
  REJECT
  SIP_USER
}

enum CallerIdMode {
  PASSTHROUGH
  OVERRIDE
  STRIP_ADD
  CALLED_NUMBER
  ANONYMOUS
}

enum NormalizationOwnerType {
  GLOBAL
  CARRIER
  CUSTOMER
}

enum RateCardType {
  CUSTOMER
  VENDOR
}

enum BillingParty {
  CUSTOMER
  VENDOR
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
  SUPPORT_MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Customer {
  id                    String                  @id @default(dbgenerated("generate_customer_code()"))
  accountCode           String                  @unique @map("account_code")
  name                  String
  creditBalance         Decimal                 @default(0) @map("credit_balance") @db.Decimal(14, 2)
  currency              String                  @default("USD")
  isActive              Boolean                 @default(true) @map("is_active")
  extensionLimit        Int                     @default(10) @map("extension_limit")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  settings              CustomerSettings?
  endpoints             CustomerEndpoint[]
  numbers               CustomerNumber[]
  numberSettings        NumberSettings[]
  routes                SwitchRoute[]
  sourceAuth            SourceIpAuth[]
  normalizationProfiles NormalizationProfile[]
  routeXml              RouteXml[]
  sipTraces             CustomerSipTrace[]
  rateCardMapping       CustomerRateCard?
  minimumBilling        CustomerMinimumBilling?
  wallet                CustomerWallet?
  sipUsers              SipUser[]
  users                 User[]
  supportAssignments    SupportAssignment[]

  @@map("customers")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  customerId   String?    @map("customer_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supportAssignments SupportAssignment[]

  @@index([customerId])
  @@index([role])
  @@index([email])
  @@map("users")
}

model SupportAssignment {
  supportMemberId String   @map("support_member_id")
  customerId      String   @map("customer_id")
  assignedAt      DateTime @default(now()) @map("assigned_at")
  supportMember   User     @relation(fields: [supportMemberId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([supportMemberId, customerId])
  @@index([customerId])
  @@map("support_assignments")
}

model SipUser {
  id               String             @id @default(uuid()) @db.Uuid
  username         String             @unique
  secretHash       String             @map("secret_hash")
  sipProfile       String             @default("internal") @map("sip_profile")
  isActive         Boolean            @default(true) @map("is_active")
  isMonitor        Boolean            @default(false) @map("is_monitor")
  customerId       String             @map("customer_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  numberSettings   NumberSettings[]   @relation("NumberTargetSipUser")
  customerSettings CustomerSettings[] @relation("CustomerSettingsDefaultTargetSipUser")

  @@index([customerId, isActive])
  @@index([customerId, isMonitor])
  @@map("sip_users")
}

model CustomerSettings {
  id                               String          @id @default(uuid())
  customerId                       String          @unique @map("customer_id")
  defaultEndpointId                String?         @map("default_endpoint_id")
  defaultIngressProfileId          String?         @map("default_ingress_profile_id")
  defaultEgressProfileId           String?         @map("default_egress_profile_id")
  defaultCallerIdMode              CallerIdMode    @default(PASSTHROUGH) @map("default_caller_id_mode")
  defaultCallerIdNumber            String?         @map("default_caller_id_number")
  defaultChannelLimit              Int?            @map("default_channel_limit")
  defaultDestinationType           DestinationType @default(CUSTOMER_ENDPOINT) @map("default_destination_type")
  defaultForwardNumber             String?         @map("default_forward_number")
  defaultTargetSipUserId           String?         @map("default_target_sip_user_id") @db.Uuid
  defaultOutboundCarrierId         String?         @map("default_outbound_carrier_id")
  defaultOutboundCarrierEndpointId String?         @map("default_outbound_carrier_endpoint_id")
  recordingEnabled                 Boolean         @default(false) @map("recording_enabled")
  createdAt                        DateTime        @default(now()) @map("created_at")
  updatedAt                        DateTime        @updatedAt @map("updated_at")
  customer                         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  defaultTargetSipUser             SipUser?        @relation("CustomerSettingsDefaultTargetSipUser", fields: [defaultTargetSipUserId], references: [id], onDelete: SetNull)

  @@map("customer_settings")
}

model Carrier {
  id                        String                 @id @default(uuid())
  name                      String                 @unique
  code                      String                 @unique
  isActive                  Boolean                @default(true) @map("is_active")
  defaultIngressProfileId   String?                @map("default_ingress_profile_id")
  defaultEgressProfileId    String?                @map("default_egress_profile_id")
  defaultChannelLimit       Int?                   @map("default_channel_limit")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")
  endpoints                 CarrierEndpoint[]
  routes                    CarrierRoute[]
  sourceAuth                SourceIpAuth[]
  normalizationProfiles     NormalizationProfile[]
  switchRoutes              SwitchRoute[]
  rateCardMapping           CarrierRateCard?
  minimumBilling            CarrierMinimumBilling?

  @@map("carriers")
}

model CarrierEndpoint {
  id                            String            @id @default(uuid())
  carrierId                     String            @map("carrier_id")
  name                          String
  host                          String
  port                          Int               @default(5060)
  transport                     Transport         @default(UDP)
  direction                     EndpointDirection @default(BOTH)
  authType                      AuthType          @default(IP) @map("auth_type")
  authUsername                  String?           @map("auth_username")
  authSecretEncrypted           String?           @map("auth_secret_encrypted")
  realm                         String?
  ingressNormalizationProfileId String?           @map("ingress_normalization_profile_id")
  egressNormalizationProfileId  String?           @map("egress_normalization_profile_id")
  channelLimit                  Int?              @map("channel_limit")
  priority                      Int               @default(100)
  weight                        Int               @default(100)
  isActive                      Boolean           @default(true) @map("is_active")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  carrier                       Carrier           @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  sourceAuth                    SourceIpAuth[]
  carrierRoutes                 CarrierRoute[]
  targetRoutes                  SwitchRoute[]     @relation("TargetCarrierEndpoint")

  @@unique([carrierId, name])
  @@index([carrierId, isActive, priority])
  @@map("carrier_endpoints")
}

model CustomerEndpoint {
  id                            String            @id @default(uuid())
  customerId                    String            @map("customer_id")
  name                          String
  host                          String
  port                          Int               @default(5060)
  transport                     Transport         @default(UDP)
  direction                     EndpointDirection @default(BOTH)
  authType                      AuthType          @default(IP) @map("auth_type")
  authUsername                  String?           @map("auth_username")
  authSecretHash                String?           @map("auth_secret_hash")
  realm                         String?
  ingressNormalizationProfileId String?           @map("ingress_normalization_profile_id")
  egressNormalizationProfileId  String?           @map("egress_normalization_profile_id")
  channelLimit                  Int?              @map("channel_limit")
  priority                      Int               @default(100)
  isActive                      Boolean           @default(true) @map("is_active")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  customer                      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceAuth                    SourceIpAuth[]
  primaryNumberSettings         NumberSettings[]  @relation("NumberPrimaryEndpoint")
  failoverNumberSettings        NumberSettings[]  @relation("NumberFailoverEndpoint")
  targetRoutes                  SwitchRoute[]     @relation("TargetCustomerEndpoint")
  failoverRoutes                SwitchRoute[]     @relation("FailoverCustomerEndpoint")

  @@unique([customerId, name])
  @@index([customerId, isActive, priority])
  @@map("customer_endpoints")
}

model NormalizationProfile {
  id          String                 @id @default(uuid())
  name        String
  ownerType   NormalizationOwnerType @map("owner_type")
  customerId  String?                @map("customer_id")
  carrierId   String?                @map("carrier_id")
  steps       Json
  description String?
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  customer    Customer?              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  carrier     Carrier?               @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([ownerType, customerId, carrierId, name])
  @@index([customerId])
  @@index([carrierId])
  @@map("normalization_profiles")
}

model SourceIpAuth {
  id                            String            @id @default(uuid())
  sourceType                    SourceType        @map("source_type")
  ipAddress                     String            @map("ip_address")
  port                          Int               @default(0)
  authUsername                  String?           @map("auth_username")
  authSecretHash                String?           @map("auth_secret_hash")
  customerId                    String?           @map("customer_id")
  carrierId                     String?           @map("carrier_id")
  customerEndpointId            String?           @map("customer_endpoint_id")
  carrierEndpointId             String?           @map("carrier_endpoint_id")
  ingressNormalizationProfileId String?           @map("ingress_normalization_profile_id")
  isActive                      Boolean           @default(true) @map("is_active")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  customer                      Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  carrier                       Carrier?          @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  customerEndpoint              CustomerEndpoint? @relation(fields: [customerEndpointId], references: [id], onDelete: SetNull)
  carrierEndpoint               CarrierEndpoint?  @relation(fields: [carrierEndpointId], references: [id], onDelete: SetNull)

  @@index([ipAddress, port, authUsername, isActive])
  @@index([customerId, isActive])
  @@index([carrierId, isActive])
  @@map("source_ip_auth")
}

model GlobalNumberInventory {
  id              String                @id @default(uuid())
  canonicalNumber String                @unique @map("canonical_number")
  displayNumber   String?               @map("display_number")
  numberType      String                @default("DID") @map("number_type")
  countryCode     String?               @map("country_code")
  region          String?
  status          NumberInventoryStatus @default(AVAILABLE)
  manuallyDisabled Boolean              @default(false) @map("manually_disabled")
  subscriptionDisabled Boolean          @default(false) @map("subscription_disabled")
  metadata        Json?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  assignment      CustomerNumber?

  @@index([status, numberType])
  @@map("global_number_inventory")
}

model CustomerNumber {
  id          String                @id @default(uuid())
  customerId  String                @map("customer_id")
  inventoryId String                @unique @map("inventory_id")
  status      CustomerNumberStatus  @default(ACTIVE)
  label       String?
  assignedAt  DateTime              @default(now()) @map("assigned_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  inventory   GlobalNumberInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  settings    NumberSettings?
  routes      SwitchRoute[]
  xml         RouteXml?
  sipTraces   CustomerSipTrace[]

  @@unique([customerId, inventoryId])
  @@index([customerId, status])
  @@map("customer_numbers")
}

model NumberSettings {
  id                            String            @id @default(uuid())
  customerId                    String            @map("customer_id")
  customerNumberId              String            @unique @map("customer_number_id")
  destinationType               DestinationType?  @map("destination_type")
  primaryEndpointId             String?           @map("primary_endpoint_id")
  forwardNumber                 String?           @map("forward_number")
  targetSipUserId               String?           @map("target_sip_user_id") @db.Uuid
  outboundCarrierEndpointId     String?           @map("outbound_carrier_endpoint_id")
  failoverEndpointId            String?           @map("failover_endpoint_id")
  failoverNumber                String?           @map("failover_number")
  ingressNormalizationProfileId String?           @map("ingress_normalization_profile_id")
  egressNormalizationProfileId  String?           @map("egress_normalization_profile_id")
  callerIdMode                  CallerIdMode?     @map("caller_id_mode")
  callerIdNumber                String?           @map("caller_id_number")
  callerIdStripPrefix           String?           @map("caller_id_strip_prefix")
  callerIdAddPrefix             String?           @map("caller_id_add_prefix")
  callTimeoutSeconds            Int?              @map("call_timeout_seconds")
  channelLimit                  Int?              @map("channel_limit")
  recordingEnabled              Boolean?          @map("recording_enabled")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  customer                      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerNumber                CustomerNumber    @relation(fields: [customerNumberId], references: [id], onDelete: Cascade)
  primaryEndpoint               CustomerEndpoint? @relation("NumberPrimaryEndpoint", fields: [primaryEndpointId], references: [id], onDelete: SetNull)
  failoverEndpoint              CustomerEndpoint? @relation("NumberFailoverEndpoint", fields: [failoverEndpointId], references: [id], onDelete: SetNull)
  targetSipUser                 SipUser?          @relation("NumberTargetSipUser", fields: [targetSipUserId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("number_settings")
}

model CarrierRoute {
  id                           String          @id @default(uuid())
  carrierId                    String          @map("carrier_id")
  carrierEndpointId            String          @map("carrier_endpoint_id")
  name                         String
  matchPrefix                  String          @map("match_prefix")
  egressNormalizationProfileId String?         @map("egress_normalization_profile_id")
  priority                     Int             @default(100)
  cost                         Decimal?        @db.Decimal(14, 6)
  channelLimit                 Int?            @map("channel_limit")
  isActive                     Boolean         @default(true) @map("is_active")
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")
  carrier                      Carrier         @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  carrierEndpoint              CarrierEndpoint @relation(fields: [carrierEndpointId], references: [id], onDelete: Cascade)

  @@unique([carrierId, name])
  @@index([matchPrefix, isActive, priority])
  @@map("carrier_routes")
}

model SwitchRoute {
  id                            String            @id @default(uuid())
  customerId                    String            @map("customer_id")
  customerNumberId              String?           @map("customer_number_id")
  name                          String
  direction                     RouteDirection
  matchType                     MatchType         @default(EXACT) @map("match_type")
  matchValue                    String            @map("match_value")
  priority                      Int               @default(100)
  destinationType               DestinationType?  @map("destination_type")
  targetCustomerEndpointId      String?           @map("target_customer_endpoint_id")
  targetCarrierId               String?           @map("target_carrier_id")
  targetCarrierEndpointId       String?           @map("target_carrier_endpoint_id")
  destinationNumber             String?           @map("destination_number")
  failoverCustomerEndpointId    String?           @map("failover_customer_endpoint_id")
  failoverNumber                String?           @map("failover_number")
  ingressNormalizationProfileId String?           @map("ingress_normalization_profile_id")
  egressNormalizationProfileId  String?           @map("egress_normalization_profile_id")
  callerIdMode                  CallerIdMode?     @map("caller_id_mode")
  callerIdNumber                String?           @map("caller_id_number")
  callerIdStripPrefix           String?           @map("caller_id_strip_prefix")
  callerIdAddPrefix             String?           @map("caller_id_add_prefix")
  channelLimit                  Int?              @map("channel_limit")
  isActive                      Boolean           @default(true) @map("is_active")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  customer                      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerNumber                CustomerNumber?   @relation(fields: [customerNumberId], references: [id], onDelete: SetNull)
  targetCustomerEndpoint        CustomerEndpoint? @relation("TargetCustomerEndpoint", fields: [targetCustomerEndpointId], references: [id], onDelete: SetNull)
  failoverCustomerEndpoint      CustomerEndpoint? @relation("FailoverCustomerEndpoint", fields: [failoverCustomerEndpointId], references: [id], onDelete: SetNull)
  targetCarrier                 Carrier?          @relation(fields: [targetCarrierId], references: [id], onDelete: SetNull)
  targetCarrierEndpoint         CarrierEndpoint?  @relation("TargetCarrierEndpoint", fields: [targetCarrierEndpointId], references: [id], onDelete: SetNull)
  xml                           RouteXml?

  @@unique([customerId, direction, matchType, matchValue, priority])
  @@index([customerId, direction, isActive, priority])
  @@index([matchValue])
  @@map("switch_routes")
}

model RouteXml {
  id               String          @id @default(uuid())
  customerId       String          @map("customer_id")
  routeId          String?         @unique @map("route_id")
  customerNumberId String?         @unique @map("customer_number_id")
  matchNumber      String?         @unique @map("match_number")
  fileName         String?         @map("file_name")
  version          Int             @default(1)
  configHash       String          @map("config_hash")
  xmlContent       String          @map("xml_content") @db.Text
  generatedAt      DateTime        @default(now()) @map("generated_at")
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  route            SwitchRoute?    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  customerNumber   CustomerNumber? @relation(fields: [customerNumberId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("route_xml")
}

model CustomerSipTrace {
  id                BigInt          @id @default(autoincrement())
  customerId        String          @map("customer_id")
  customerNumberId  String?         @map("customer_number_id")
  cdrId             BigInt          @unique @map("cdr_id")
  sessionUuid       String          @unique @map("session_uuid")
  callIds           String[]        @default([]) @map("call_ids")
  correlationId     String?         @map("correlation_id")
  direction         String
  callerNumber      String?         @map("caller_number")
  calledNumber      String?         @map("called_number")
  customerNumber    String?         @map("customer_number")
  status            String
  responseCode      Int?            @map("response_code")
  durationSeconds   Int             @default(0) @map("duration_seconds")
  sourceIp          String?         @map("source_ip")
  destinationIp     String?         @map("destination_ip")
  captureId         Int             @default(61) @map("capture_id")
  startedAt         DateTime        @map("started_at")
  endedAt           DateTime?       @map("ended_at")
  participants      Json?
  messagesSnapshot  Json?           @map("messages_snapshot")
  syncedAt          DateTime?       @map("synced_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedNumber    CustomerNumber? @relation(fields: [customerNumberId], references: [id], onDelete: SetNull)

  @@index([customerId, startedAt])
  @@index([customerNumberId, startedAt])
  @@index([startedAt])
  @@map("customer_sip_traces")
}

model RateCard {
  id                              String             @id @default(uuid())
  name                            String
  type                            RateCardType
  currency                        String             @default("USD") @db.VarChar(3)
  description                     String?
  inboundRatePerMinute            Decimal            @default(0) @map("inbound_rate_per_minute") @db.Decimal(18, 6)
  inboundInitialIncrementSeconds  Int                @default(60) @map("inbound_initial_increment_seconds")
  inboundIncrementSeconds         Int                @default(60) @map("inbound_increment_seconds")
  outboundRatePerMinute           Decimal            @default(0) @map("outbound_rate_per_minute") @db.Decimal(18, 6)
  outboundInitialIncrementSeconds Int                @default(60) @map("outbound_initial_increment_seconds")
  outboundIncrementSeconds        Int                @default(60) @map("outbound_increment_seconds")
  version                         Int                @default(1)
  isActive                        Boolean            @default(true) @map("is_active")
  createdAt                       DateTime           @default(now()) @map("created_at")
  updatedAt                       DateTime           @updatedAt @map("updated_at")
  customerMappings                CustomerRateCard[]
  carrierMappings                 CarrierRateCard[]

  @@unique([type, name])
  @@index([type, isActive])
  @@map("rate_cards")
}

model CustomerRateCard {
  customerId    String    @id @map("customer_id")
  rateCardId    String    @map("rate_card_id")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rateCard      RateCard  @relation(fields: [rateCardId], references: [id], onDelete: Restrict)

  @@index([rateCardId])
  @@map("customer_rate_cards")
}

model CarrierRateCard {
  carrierId     String    @id @map("carrier_id")
  rateCardId    String    @map("rate_card_id")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  carrier       Carrier   @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  rateCard      RateCard  @relation(fields: [rateCardId], references: [id], onDelete: Restrict)

  @@index([rateCardId])
  @@map("carrier_rate_cards")
}

model MinimumBillingSetting {
  id                      String                   @id @default(uuid())
  name                    String
  party                   BillingParty
  initialIncrementSeconds Int                      @default(60) @map("initial_increment_seconds")
  incrementSeconds        Int                      @default(60) @map("increment_seconds")
  description             String?
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  customerMappings        CustomerMinimumBilling[]
  carrierMappings         CarrierMinimumBilling[]

  @@unique([party, name])
  @@index([party, isActive])
  @@map("minimum_billing_settings")
}

model CustomerMinimumBilling {
  customerId String                @id @map("customer_id")
  settingId  String                @map("setting_id")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  setting    MinimumBillingSetting @relation(fields: [settingId], references: [id], onDelete: Restrict)

  @@index([settingId])
  @@map("customer_minimum_billing")
}

model CarrierMinimumBilling {
  carrierId String                @id @map("carrier_id")
  settingId String                @map("setting_id")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  carrier   Carrier               @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  setting   MinimumBillingSetting @relation(fields: [settingId], references: [id], onDelete: Restrict)

  @@index([settingId])
  @@map("carrier_minimum_billing")
}

model CustomerWallet {
  id               String   @id @default(uuid())
  customerId       String   @unique @map("customer_id")
  currency         String   @default("USD") @db.VarChar(10)
  fiatBalance      Decimal  @default(0) @map("fiat_balance") @db.Decimal(14, 2)
  creditLimit      Decimal  @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditUsed       Decimal  @default(0) @map("credit_used") @db.Decimal(14, 2)
  tfnFreeMinutes   Int      @default(0) @map("tfn_free_minutes")
  didFreeMinutes   Int      @default(0) @map("did_free_minutes")
  obFreeMinutes    Int      @default(0) @map("ob_free_minutes")
  isSuspended      Boolean  @default(false) @map("is_suspended")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_wallets")
}

model Transaction {
  id                BigInt   @id @default(autoincrement())
  customerId        String   @map("customer_id")
  sourceType        String   @default("cdr") @map("source_type") @db.VarChar(20)
  sourceRef         String?  @map("source_ref")
  idempotencyKey    String?  @unique @map("idempotency_key") @db.VarChar(100)
  currency          String   @default("USD") @db.VarChar(10)
  direction         String?
  numberType        String?  @map("number_type") @db.VarChar(10)
  billsec           Int      @default(0)
  ratedSeconds      Int      @default(0) @map("rated_seconds")
  freeMinutesUsed   Int      @default(0) @map("free_minutes_used")
  fiatDebitAmount   Decimal  @default(0) @map("fiat_debit_amount") @db.Decimal(14, 6)
  creditDebitAmount Decimal  @default(0) @map("credit_debit_amount") @db.Decimal(14, 6)
  balanceAfter      Decimal? @map("balance_after") @db.Decimal(14, 2)
  rateCardId        String?  @map("rate_card_id")
  sellRatePerMinute Decimal? @map("sell_rate_per_minute") @db.Decimal(18, 6)
  carrierCost       Decimal? @default(0) @map("carrier_cost") @db.Decimal(14, 6)
  status            String   @default("posted") @db.VarChar(20)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt(sort: Desc)])
  @@index([idempotencyKey])
  @@index([sourceType, sourceRef])
  @@map("transactions")
}

model RecordingRateCard {
  id        Int      @id @default(autoincrement())
  name      String
  days      Int      @default(30)
  rate      Decimal  @default(0) @db.Decimal(14, 6)
  pulse     Int      @default(60)
  activeIs  String   @default("Y") @map("active_is") @db.VarChar(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rec_rate_card")
}

model CustomerRecordingRateCard {
  custId    String   @id @map("cust_id")
  recRcId   Int      @map("rec_rc_id")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("customer_rec_rc")
}

model RecordingBilling {
  id          BigInt    @id @default(autoincrement())
  cdrId       BigInt    @map("cdr_id")
  recRcId     Int       @map("rec_rc_id")
  custId      String    @map("cust_id")
  recFileInfo String?   @map("rec_file_info")
  duration    Int       @default(0)
  expiry      DateTime? @db.Date
  amount      Decimal   @default(0) @db.Decimal(14, 6)
  txId        BigInt?   @map("tx_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([cdrId])
  @@index([custId, createdAt(sort: Desc)])
  @@index([txId])
  @@map("rec")
}
